ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLASSIFY_MODEL=claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-5
CHECKPOINT_DB_PATH=backend/data/checkpoints.db

# Optional overrides — sensible defaults if left unset.
# MAX_ITERATIONS=6
# MAX_DELEGATIONS=4
# SUMMARY_TRIGGER_COUNT=10
# KEEP_RECENT_COUNT=4
# WRITE_GATE_MIN_SEVERITY=medium
# TICKETS_DB_PATH=backend/data/tickets.db
# APPROVALS_DB_PATH=backend/data/approvals.db

# Phase 4 — Step 4 (async job queue)
# JOBS_DB_PATH=backend/data/jobs.db
# JOB_WORKERS=4

# Phase 4 — Step 5 (tracing → Phoenix)
# TRACING_ENABLED=true
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_PROJECT_NAME=resilient-agent-gateway

# Phase 4 — Step 6 (LLM-as-judge)
# JUDGE_MODEL=claude-sonnet-5
# JUDGE_PASS_FLOOR=3
# JUDGE_DB_PATH=backend/data/judge.db

# Phase 4 — Step 7 (monitoring daemon)
# SLO_LATENCY_P95_MS=30000
# SLO_ERROR_RATE=0.10
# SLO_JUDGE_MEAN=3.5
# SLO_JOB_FAILURE_RATE=0.20
# SLO_MIN_SAMPLE=5
# PAGER_WEBHOOK_URL=            # optional: Slack incoming webhook / PagerDuty Events URL
# MONITOR_STATE_PATH=backend/data/monitor_state.json
# ALERTS_LOG_PATH=backend/data/alerts.jsonl

# Phase 4 — Step 8 (semantic cache + cost model)
# SEMANTIC_CACHE_ENABLED=true
# CACHE_SIMILARITY_THRESHOLD=0.92
# CACHE_TTL_HOURS=24
# CACHE_POLICY_VERSION=kb-v1     # bump when KB articles or prompts change
# CACHE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# SEMANTIC_CACHE_DB_PATH=backend/data/semantic_cache.db
# COST_MODEL_MONTHLY_TURNS=20000

# Phase 4 — Step 9 (dynamic model router)
# Tier models (utility/standard fall back to CLASSIFY_MODEL / AGENT_MODEL above):
# TIER_ECONOMY_MODEL=claude-haiku-5-5
# TIER_UTILITY_MODEL=claude-haiku-4-5-20251001
# TIER_STANDARD_MODEL=claude-sonnet-5
# TIER_FRONTIER_MODEL=claude-opus-5-5
# Per-agent tier overrides (agents: classify, summarize, dispatcher, specialist, synthesizer, supervisor):
# ROUTER_AGENT_TIERS={"specialist": "frontier", "classify": "economy"}
# Rolling-window budget per tier ("virtual key"), USD:
# BUDGET_ECONOMY_USD=1.00
# BUDGET_UTILITY_USD=2.00
# BUDGET_STANDARD_USD=10.00
# BUDGET_FRONTIER_USD=5.00
# BUDGET_WINDOW_HOURS=24
# ROUTER_LEDGER_DB_PATH=backend/data/router_ledger.db
