ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLASSIFY_MODEL=claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-5
CHECKPOINT_DB_PATH=backend/data/checkpoints.db

# Optional overrides — sensible defaults if left unset.
# MAX_ITERATIONS=6
# MAX_DELEGATIONS=4
# SUMMARY_TRIGGER_COUNT=10
# KEEP_RECENT_COUNT=4
# WRITE_GATE_MIN_SEVERITY=medium
# TICKETS_DB_PATH=backend/data/tickets.db
# APPROVALS_DB_PATH=backend/data/approvals.db

# Phase 4 — Step 4 (async job queue)
# JOBS_DB_PATH=backend/data/jobs.db
# JOB_WORKERS=4

# Phase 4 — Step 5 (tracing → Phoenix)
# TRACING_ENABLED=true
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_PROJECT_NAME=resilient-agent-gateway

# Phase 4 — Step 6 (LLM-as-judge)
# JUDGE_MODEL=claude-sonnet-5
# JUDGE_PASS_FLOOR=3
# JUDGE_DB_PATH=backend/data/judge.db
